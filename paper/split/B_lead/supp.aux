\@writefile{lot}{\contentsline {table}{\numberline {S1}{\ignorespaces Internet-bearing filings against the rest of their Nice class (Section~\ref {sec:internet}). Registration is the share of class-records filed 1995--2018 that reached registration; failure is the share of unique registrations 2002--2018 cancelled for non-use at age 4.0--8.5 years. Classes with fewer than 500 internet-bearing registrations are omitted.}}{3}{table.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:internetS}{{S1}{3}{Internet-bearing filings against the rest of their Nice class (Section~\ref {sec:internet}). Registration is the share of class-records filed 1995--2018 that reached registration; failure is the share of unique registrations 2002--2018 cancelled for non-use at age 4.0--8.5 years. Classes with fewer than 500 internet-bearing registrations are omitted}{table.caption.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S2}{\ignorespaces The 2000--2004 reversal, cell by cell. Technology-class registrations filed 2000--2004 and settled at the five-year proof; each carries its dominant $T=50$ theme and the internet text flag of Section~\ref {sec:internet}. Every theme$\times $flag cell holding at least 5{,}000 registrations is shown. \emph  {Share} is the cell's share of the era's filings; \emph  {of top fifth}, its share of the era's pooled leading fifth. Q5$-$Q1 is the failure contrast between the most leading and most lagging fifths, quintiles reassigned within the cell; in the bottom block, quintiles are pooled across the era (first two rows) or cut within class$\times $cohort (last two).}}{4}{table.caption.3}\protected@file@percent }
\newlabel{tab:reversaldecomp}{{S2}{4}{The 2000--2004 reversal, cell by cell. Technology-class registrations filed 2000--2004 and settled at the five-year proof; each carries its dominant $T=50$ theme and the internet text flag of Section~\ref {sec:internet}. Every theme$\times $flag cell holding at least 5{,}000 registrations is shown. \emph {Share} is the cell's share of the era's filings; \emph {of top fifth}, its share of the era's pooled leading fifth. Q5$-$Q1 is the failure contrast between the most leading and most lagging fifths, quintiles reassigned within the cell; in the bottom block, quintiles are pooled across the era (first two rows) or cut within class$\times $cohort (last two)}{table.caption.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {S2.4}Surges}{5}{subsection.2.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {S2}{\ignorespaces Four surge episodes under the 500-theme model. \emph  {Left:} the theme's share of its class's filings by filing year (for the online software episode, of all filings corpus-wide), on the 25\% systematic sample the surge screen uses; the open circle marks the surge year. \emph  {Right:} failure at the five-year proof for registrations whose dominant theme was the surging one, filed in the three-year surge window (colored, 95\% intervals), against the rest of the same class in the same cohorts (grey).}}{5}{figure.caption.4}\protected@file@percent }
\newlabel{fig:surgesS}{{S2}{5}{Four surge episodes under the 500-theme model. \emph {Left:} the theme's share of its class's filings by filing year (for the online software episode, of all filings corpus-wide), on the 25\% systematic sample the surge screen uses; the open circle marks the surge year. \emph {Right:} failure at the five-year proof for registrations whose dominant theme was the surging one, filed in the three-year surge window (colored, 95\% intervals), against the rest of the same class in the same cohorts (grey)}{figure.caption.4}{}}
\@writefile{toc}{\contentsline {section}{\numberline {S3}Success: unfunded listings, value tiers, and curated vocabularies}{5}{section.3}\protected@file@percent }
\newlabel{supp:success}{{S3}{5}{Success: unfunded listings, value tiers, and curated vocabularies}{section.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S3}{\ignorespaces The ladder by fifth of debut lead and of debut atypicality. Rates in percent of owners whose first registered filing was made 2009--2018 ($n = 999{,}442$); fifths cut within Nice class, debut year, and fifth of description length. The last column is the most-minus-least contrast with its $t$-statistic.}}{6}{table.caption.5}\protected@file@percent }
\newlabel{tab:ladderS}{{S3}{6}{The ladder by fifth of debut lead and of debut atypicality. Rates in percent of owners whose first registered filing was made 2009--2018 ($n = 999{,}442$); fifths cut within Nice class, debut year, and fifth of description length. The last column is the most-minus-least contrast with its $t$-statistic}{table.caption.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {S4}{\ignorespaces Every outcome in the funnel, conditioned on its prerequisite, under one specification. Unit is the debut owner, scored on that owner's first filing. Each row is a linear probability model with class$\times $debut-year fixed effects and heteroskedasticity-robust errors; coefficients are percentage points per standard deviation. \emph  {Atypicality} is the average of the two KL levels; \emph  {lead} is the signed difference; the lead-magnitude column $|L|$ comes from a second specification that adds it. Cohort windows differ because each maintenance deadline needs elapsed time and Form~D is electronic only from 2009, so the rows are not a nested decomposition. The five-year proof row is survival of a dated cancellation for non-use; the year-ten row is whether a registration that passed the proof was renewed rather than cancelled or expired, restricted to 2002--2013 cohorts, since a year-six and a year-ten cancellation share a terminal status and are separable only by date.}}{6}{table.caption.6}\protected@file@percent }
\newlabel{tab:staged}{{S4}{6}{Every outcome in the funnel, conditioned on its prerequisite, under one specification. Unit is the debut owner, scored on that owner's first filing. Each row is a linear probability model with class$\times $debut-year fixed effects and heteroskedasticity-robust errors; coefficients are percentage points per standard deviation. \emph {Atypicality} is the average of the two KL levels; \emph {lead} is the signed difference; the lead-magnitude column $|L|$ comes from a second specification that adds it. Cohort windows differ because each maintenance deadline needs elapsed time and Form~D is electronic only from 2009, so the rows are not a nested decomposition. The five-year proof row is survival of a dated cancellation for non-use; the year-ten row is whether a registration that passed the proof was renewed rather than cancelled or expired, restricted to 2002--2013 cohorts, since a year-six and a year-ten cancellation share a terminal status and are separable only by date}{table.caption.6}{}}
