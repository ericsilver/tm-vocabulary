\@writefile{lof}{\contentsline {figure}{\numberline {S7}{\ignorespaces Filings 2013--2015 pooled across classes, theme-scored on per-filing reference windows ($n = 1{,}419{,}678$; proof-facing subset $n = 763{,}902$). \emph  {A:} the unconditional composite P(registered and passed the five-year proof) over all filings. \emph  {B:} P(passed $\mid $ registered and facing the proof) on the same filings. The unconditional view is nearly flat in lead (22.4\% to 22.1\% across quintiles); conditioning on grant is what exposes the gradient.}}{12}{figure.caption.8}\protected@file@percent }
\newlabel{fig:uncond}{{S7}{12}{Filings 2013--2015 pooled across classes, theme-scored on per-filing reference windows ($n = 1{,}419{,}678$; proof-facing subset $n = 763{,}902$). \emph {A:} the unconditional composite P(registered and passed the five-year proof) over all filings. \emph {B:} P(passed $\mid $ registered and facing the proof) on the same filings. The unconditional view is nearly flat in lead (22.4\% to 22.1\% across quintiles); conditioning on grant is what exposes the gradient}{figure.caption.8}{}}
